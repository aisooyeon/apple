[Rule]

[Rewrite]
#大众点评
request if ${url} ~= /^https?:\/\/103\.37\.155\.60\/fetch/i then reject(404)
request if ${url} ~= /^https?:\/\/catdot\.dianping\.com\/broker-service\/hijack/i then reject(404)
request if ${url} ~= /^https?:\/\/mapi\.dianping\.com\/mapi\/operating\/(?>indexopsmodules|loadsplashconfig)/i then reject(404)
request if ${url} ~= /^https?:\/\/mapi\.dianping\.com\/mapi\/intelliindex/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/mapi\.dianping\.com\/wdrpreload\/userprediction/i then reject(404)
request if ${url} ~= /^https?:\/\/mapi\.dianping\.com\/adshopping/i then reject(404)
request if ${url} ~= /^https?:\/\/img\.meituan\.net\/goodsawardpic\/\w+\.gif/i then reject_img(200)
request if ${url} ~= /^https?:\/\/p\.meituan\.com\/api\/privacy\/config/i then reject(404)
request if ${url} ~= /^https?:\/\/rms\.meituan\.com\/api\/v\d\/rmsmina\/c\/queryWechatAdvertisement/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/www\.dpfile\.com\/app\/fecommonservice-lottie\/ugc-write-done\/media/i then reject(404)
request if ${url} ~= /^https?:\/\/www\.dpfile\.com\/picasso\/picasso-qa\/src\/AnswerList\/AnswerList-bundle/i then reject(404)
request if ${url} ~= /^https?:\/\/www\.dpfile\.com\/sc\/indexpromotion/i then reject(404)
request if ${url} ~= /^https?:\/\/catfront\.dianping\.com\/api\/metric\?v=\d&p=rn_gcbu_mrn-joy-poidetail/i then reject(404)
request if ${url} ~= /^https?:\/\/awp-assets\.meituan\.net\/hfe\/fep\/\w+\.json/i then reject(404)
request if ${url} ~= /^https?:\/\/s3plus\.meituan\.net\/ocean-blk-index\/index\/blk_conf/i then reject(404)
request if ${url} ~= /^https?:\/\/p\d\.meituan\.net\/nrpresourcevenus\/\w+\.gif/i then reject_img(200)
request if ${url} ~= /^https?:\/\/p\d\.meituan\.net\/travelcube\/(?!c129a661)\w+\.gif/i then reject_img(200)
request if ${url} ~= /^https?:\/\/ddplus\.meituan\.net\/v\d\/mss_\w+\/(?>ehc|titansx|ddblue|edfu)\//i then reject(404)
#同程
request if ${url} ~= /^https?:\/\/wx\.17u\.cn\/flightedward\/jointHoliday\/appIndex\/getstartupservices/i then reject(404)
request if ${url} ~= /^https?:\/\/tcmobileapi\.17usoft\.com\/appindexnew\/index\/getappindexconfig/i then reject(404)
request if ${url} ~= /^https?:\/\/tcmobileapi\.17usoft\.com\/appindexnew\/index\/openscreen/i then reject(404)
#高德地图
request if ${url} ~= /^https?:\/\/m5\.amap\.com\/ws\/shield\/dsp\/app\/startup\/init\?/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/m5\.amap\.com\/ws\/valueadded\//i then reject(404)
request if ${url} ~= /^https?:\/\/optimus-ads\.amap\.com\/uploadimg\/[a-zA-Z0-9]+.gif/i then reject(200)
request if ${url} ~= /^https?:\/\/amap-aos-info-nogw\.amap\.com\/ws\/aos\/alimama\/splash_screen_rt/i then reject(404)
#爱奇艺
# 播放页开通会员提示
request if ${url} ~= /^https?:\/\/act\.vip\.iqiyi\.com\/interact\/api\/v2\/show\?/i then reject_dict(200)
# 播放页多余动效
request if ${url} ~= /^https?:\/\/iface2\.iqiyi\.com\/ivos\/interact\/video\/data\?/i then reject_dict(200)
# 播放页升级白金会员按钮
request if ${url} ~= /^https?:\/\/iface2\.iqiyi\.com\/video\/3\.0\/v_interface_proxy\?/i then reject_dict(200)
# 青少年弹窗
request if ${url} ~= /^https?:\/\/iface2\.iqiyi\.com\/views_pop\/3\.0\/pop_control\?/i then reject_dict(200)
#航旅纵横
request if ${url} ~= /^https?:\/\/oss\.umetrip\.com\/fs\/advert\/polite/i then reject(404)
request if ${url} ~= /^https?:\/\/(discardrp|startup)\.umetrip\.com\/gateway\/api\/umetrip\/native/i then reject(404)
request if ${url} ~= /^https?:\/\/(?:114\.115\.217\.129|home\.umetrip\.com)\/gateway\/api\/umetrip\/native$/ && ${request.header['rpid']} ~= /1000002|1000019/ then reject(404)
#途家
response if ${url} ~= /^https?:\/\/client\.tujia\.com\/bnbapp-node\/app\/portal\/getStartPictureAdvertising(?:\?.*)?$/ then response.json.jq(".content.startPictureAdvertising.bannerModule.banners = []")
request if ${url} ~= /^https:\/\/client\.tujia\.com\/bnbapp-node\/app\/portal\/getStartPictureAdvertising(?:\?.*)?$/ then reject(200)
#微信我的医保
response if ${url} ~= /^https?:\/\/card\.wecity\.qq\.com\/trpcapi\/AdvCfg\/AdvRulePlayV2(?:\?.*)?$/ then response.json.jq(".advs = []")
#东方财富
request if ${url} ~= /^https?:\/\/[a-z]+\.eastmoney\.com\/infoService\//i then reject(404)
request if ${url} ~= /^https?:\/\/emdcadvise\.eastmoney\.com\/infoAdviseService\//i then reject(404)
#京东
request if ${url} ~= /^https?:\/\/img10\.360buyimg\.com\/(deliveryadmin|mcmktresadmin)\/jfs\/t1/i then reject(404)
request if ${url} ~= /^https?:\/\/img11\.360buyimg\.com\/dl\/jfs\/t1/i then reject(404)
request if ${url} ~= /^https?:\/\/m\.360buyimg\.com\/mobilecms\/s1125x2436_jfs/i then reject(404)
request if ${url} ~= /^https?:\/\/m\.360buyimg\.com\/mobilecms\/s1125x2001_jfs/i then reject(404)
request if ${url} ~= /^https?:\/\/api\.m\.jd\.com\/api\?functionId=union_exhibition_bff$/i then reject(404)
response if ${url} ~= /^https?:\/\/jdread-api\.jd\.com\/jdread\/api\/user\/ad(?:\?.*)?$/ then response.json.jq(".data.show_ad = false | .data.show_ad_tm = 0")
response if ${url} ~= /^https?:\/\/jdread-api\.jd\.com\/jdread\/api\/popup(?:\?|$)/ then response.json.jq(".data.popup_windows = [] | .data.startup_prompts = []")
response if ${request.method} == "POST" && ${url} ~= /^https:\/\/api\.m\.jd\.com\/api\?functionId=jdread_api_channel_cid(?:&|$)/ && ${response.status} == 200 then response.json.jq(".data.modules |= (if type == \"array\" then map(select(.title != \"我的底栏\")) else . end)")
#美团
request if ${url} ~= /^https?:\/\/(img|s3plus)\.meituan\.net\/(adunion|bizad)\//i then reject(404)
request if ${url} ~= /^https?:\/\/img\.meituan\.net\/wmbanner/i then reject(404)
request if ${url} ~= /^https?:\/\/s3plus\.meituan\.net\/v1\/\w+\/(yunying-video|brandcpt-vedio)\/\w+/i then reject(404)
request if ${url} ~= /^https?:\/\/img\.meituan\.net\/\w+\/bizad\/\w+\.(jpg|png)/i then reject(404)
#e生活
request if ${url} ~= /^https?:\/\/elife\.icbc\.com\.cn\/OFSTNEWBASE\/lifeIndex/i then reject(404)
response if ${url} ~= /^https?:\/\/elife\.icbc\.com\.cn\/OFSTNEWBASE\/floorinfo\/getStartupMantleFlatingFloor\.do(?:\?.*)?$/ then response.json.jq("(.data[]? | select(.floorId == \"qdp\") | .startupDto) = [] | (.data[]? | select(.floorId == \"JX001\") | .activities) = []")
[Script]
#大众点评
response if ${url} ~= /^https?:\/\/img\.meituan\.net\/(?>dpmobile|goodsawardpic)\//i then script("https://raw.githubusercontent.com/zirawell/R-Store/main/Res/Scripts/AntiAd/dianping.js") with enable=${davsdmpk_enable}, tag="大众点评", timeout=60, requires_body=true
response if ${url} ~= /^https?:\/\/ddplus\.meituan\.net\/v\d\/mss_\w+\/picassovc/i then script("https://raw.githubusercontent.com/zirawell/R-Store/main/Res/Scripts/AntiAd/dianping.js") with enable=${davsdmpk_enable}, tag="大众点评", timeout=60, requires_body=true
#美丽修行
response if ${url} ~= /^https?:\/\/api\.bevol\.com\/(?:appmain\/app\/home\/page|usercenter\/account\/info|personal\/page|appmain\/app\/home\/launch|trialbox\/shop\/app\/homePage)$/i then script("https://github.com/fmz200/wool_scripts/raw/main/Scripts/mlxx/mlxx.js") with tag="美丽修行", timeout=60, requires_body=true
#爱奇艺
response if ${url} ~= /^https?:\/\/[\d\.]+\/3f1\/cards\.iqiyi\.com\/(views_home\/3\.0\/qy_home|waterfall\/3\.0\/feed)\?/i then script("https://raw.githubusercontent.com/fmz200/wool_scripts/main/Scripts/cnftp.js") with enable=${aiqiyi_enable}, tag="爱奇艺首页信息流广告", timeout=60, requires_body=true
response if ${url} ~= /^https?:\/\/access\.if\.iqiyi\.com\/3f1\/cards\.iqiyi\.com\/(views_category\/3\.0\/category_home|views_home\/3\.0\/qy_home|waterfall\/3\.0\/feed)\?/i then script("https://raw.githubusercontent.com/fmz200/wool_scripts/main/Scripts/cnftp.js") with enable=${aiqiyi_enable}, tag="爱奇艺首页信息流广告", timeout=60, requires_body=true
response if ${url} ~= /^https?:\/\/cards\.iqiyi\.com\/views_category\/3\.0\/(category_home|categorylib_content|film_hybrid)\?/i then script("https://raw.githubusercontent.com/fmz200/wool_scripts/main/Scripts/cnftp.js") with enable=${aiqiyi_enable}, tag="爱奇艺首页信息流广告", timeout=60, requires_body=true
response if ${url} ~= /^https?:\/\/cards\.iqiyi\.com\/(views_home\/3\.0\/qy_home|waterfall\/3\.0\/feed)\?/i then script("https://raw.githubusercontent.com/fmz200/wool_scripts/main/Scripts/cnftp.js") with enable=${aiqiyi_enable}, tag="爱奇艺首页信息流广告", timeout=60, requires_body=true
# 播放详情页
response if ${url} ~= /^https?:\/\/cards\.iqiyi\.com\/views_plt\/3\.0\/player_tabs_v2\?/i then script("https://raw.githubusercontent.com/fmz200/wool_scripts/main/Scripts/cnftp.js") with enable=${aiqiyi_enable}, tag="爱奇艺播放详情页广告", timeout=60, requires_body=true
# 搜索页列表
response if ${url} ~= /^https?:\/\/cards\.iqiyi\.com\/views_search\/3\.0\/(hot_query_)?search\?/i then script("https://raw.githubusercontent.com/fmz200/wool_scripts/main/Scripts/cnftp.js") with enable=${aiqiyi_enable}, tag="爱奇艺搜索页列表广告", timeout=60, requires_body=true
# 评论区
response if ${url} ~= /^https?:\/\/comment-card\.iqiyi\.com\/views_comment\/3\.0\/long_video_comments\?/i then script("https://raw.githubusercontent.com/fmz200/wool_scripts/main/Scripts/cnftp.js") with enable=${aiqiyi_enable}, tag="爱奇艺评论区", timeout=60, requires_body=true
# 我的页面菜单
response if ${url} ~= /^https?:\/\/iface2\.iqiyi\.com\/aggregate\/3\.0\/getMyMenus\?/i then script("https://raw.githubusercontent.com/fmz200/wool_scripts/main/Scripts/cnftp.js") with enable=${aiqiyi_enable}, tag="爱奇艺我的页面菜单", timeout=60, requires_body=true
# 首页左上角天气
response if ${url} ~= /^https?:\/\/iface2\.iqiyi\.com\/control\/3\.0\/init_proxy\?/i then script("https://raw.githubusercontent.com/fmz200/wool_scripts/main/Scripts/cnftp.js") with enable=${aiqiyi_enable}, tag="爱奇艺首页左上角天气", timeout=60, requires_body=true
# 通用控制,各tab页二楼
response if ${url} ~= /^https?:\/\/iface2\.iqiyi\.com\/fusion\/3\.0\/common_switch\?/i then script("https://raw.githubusercontent.com/fmz200/wool_scripts/main/Scripts/cnftp.js") with enable=${aiqiyi_enable}, tag="爱奇艺通用控制", timeout=60, requires_body=true
# 底部tab、顶部tab
response if ${url} ~= /^https?:\/\/iface2\.iqiyi\.com\/views\/3\.0\/(bottom_theme|home_top_menu)\?/i then script("https://raw.githubusercontent.com/fmz200/wool_scripts/main/Scripts/cnftp.js") with enable=${aiqiyi_enable}, tag="爱奇艺底部tab、顶部tab", timeout=60, requires_body=true
# 搜索框填充词
response if ${url} ~= /^https?:\/\/search\.video\.iqiyi\.com\/q\?/i then script("https://raw.githubusercontent.com/fmz200/wool_scripts/main/Scripts/cnftp.js") with enable=${aiqiyi_enable}, tag="爱奇艺搜索框填充词", timeout=60, requires_body=true
# 开屏广告,播放广告
response if ${url} ~= /^https?:\/\/(kjp|t7z)\.cupid\.iqiyi\.com\/mixer\?/i then script("https://raw.githubusercontent.com/fmz200/wool_scripts/main/Scripts/cnftp.js") with enable=${aiqiyi_enable}, tag="爱奇艺开屏广告", timeout=60, requires_body=true

[MITM]
hostname = *17u.cn, *17usoft.com, *umetrip.com, *360buyimg.com, *jd.com, *eastmoney.com, *tujia.com, card.wecity.qq.com, 103.37.155.60, *.dianping.com, *meituan.net, *iqiyi.com, elife.icbc.com.cn, *amap.com

